# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# SMTP2GO Coach invitation delivery. The sender must be authorized in SMTP2GO.
# Keep the API key server-side; it is never returned to the browser.
SMTP2GO_API_KEY=api-xxxxxxxxxxxxxxxxxxxx
SMTP2GO_SENDER=Jetta Golf <noreply@jetta.com>
# SMTP2GO_REPLY_TO=support@jetta.com
GOLFGAME_PUBLIC_URL=https://golfgame.jetta.com
# Keep disabled in local/test environments. Enable only on the production server.
GOLFGAME_EMAIL_DELIVERY=disabled

# Comma-separated account emails allowed to open the developer feedback inbox.
# admin@jetta.com is used by default when this setting is omitted.
GOLFGAME_DEVELOPER_EMAILS=admin@jetta.com

# Optional comma-separated local-development player names. Do not use names as
# developer authorization in production; authenticated email is preferred.
# GOLFGAME_DEVELOPER_NAMES=Feedback Developer

# Licensing starts in shadow mode: decisions are recorded, but existing players
# are not blocked. Change to enforced only after issuing access to current users.
GOLFGAME_LICENSE_ENFORCEMENT=shadow
GOLFGAME_COACH_SEAT_CAPACITY=10
GOLFGAME_COACH_GRACE_DAYS=30
GOLFGAME_LICENSE_WORKER_BATCH_SIZE=50
GOLFGAME_LICENSE_NOTIFICATION_CLAIM_MINUTES=15

# Golf Intelligence credentials stay on the server. Paid course-detail calls
# still start OFF after each server restart and must be enabled in Course Mapper.
GOLF_INTELLIGENCE_ENABLED=true
GOLF_INTELLIGENCE_BASE_URL=https://api.golfintelligence.com
GOLF_INTELLIGENCE_CLIENT_ID=
GOLF_INTELLIGENCE_ACTIVE_TOKEN=
GOLF_INTELLIGENCE_TIMEOUT_SECONDS=20
GOLF_INTELLIGENCE_CACHE_TTL_DAYS=365
# Provider pricing may change; this value only labels the confirmation screen.
GOLF_INTELLIGENCE_FULL_DETAIL_CREDITS=3
GOLF_INTELLIGENCE_GPS_ONLY_CREDITS=2

# Optional local AI settings
# OLLAMA_MODEL=qwen3.5:4b
